# =============================================================================
# pgbench4perffarm — Deterministic PostgreSQL Server Configuration Template
# =============================================================================
# Generated by: perffarm/generate_pgconf.py
# Animal Name : @ANIMAL_NAME@
# Sizing Tier : @SIZING_PRESET@
# PG Version  : @PG_VERSION@
# Server Host : @SERVER_HOSTNAME@ (@CPU_LOGICAL@ vCPUs / @RAM_GB@ GB RAM / @DATA_DISK_MEDIA@)
# =============================================================================

# --- Connection & Network Settings ---
listen_addresses = '@LISTEN_ADDRESSES@'
max_connections = @MAX_CONNECTIONS@
superuser_reserved_connections = 3

# --- Memory Allocation ---
shared_buffers = '@SHARED_BUFFERS@'
effective_cache_size = '@EFFECTIVE_CACHE_SIZE@'
maintenance_work_mem = '@MAINTENANCE_WORK_MEM@'
work_mem = '@WORK_MEM@'
huge_pages = @HUGE_PAGES@

# --- Checkpoints & Write-Ahead Log (WAL) ---
wal_level = replica
wal_buffers = '@WAL_BUFFERS@'
min_wal_size = '@MIN_WAL_SIZE@'
max_wal_size = '@MAX_WAL_SIZE@'
checkpoint_timeout = '@CHECKPOINT_TIMEOUT@'
checkpoint_completion_target = 0.9
checkpoint_warning = 30s
synchronous_commit = on
full_page_writes = on
wal_compression = @WAL_COMPRESSION@

# --- Background Writer ---
bgwriter_delay = 20ms
bgwriter_lru_maxpages = 400
bgwriter_lru_multiplier = 4.0

# --- Parallelism & Worker Processes ---
max_worker_processes = @MAX_WORKER_PROCESSES@
max_parallel_workers = @MAX_PARALLEL_WORKERS@
max_parallel_workers_per_gather = @MAX_PARALLEL_WORKERS_PER_GATHER@
max_parallel_maintenance_workers = @MAX_PARALLEL_MAINTENANCE_WORKERS@

# --- Query Planner & I/O Cost Model (@DATA_DISK_MEDIA@) ---
random_page_cost = @RANDOM_PAGE_COST@
seq_page_cost = 1.0
effective_io_concurrency = @EFFECTIVE_IO_CONCURRENCY@
@MAINTENANCE_IO_CONCURRENCY_LINE@
default_statistics_target = 100
jit = @JIT_SETTING@

# --- Autovacuum (Deterministic Baseline) ---
autovacuum = on
autovacuum_max_workers = @AUTOVACUUM_MAX_WORKERS@
autovacuum_naptime = 15s
autovacuum_vacuum_scale_factor = 0.05
autovacuum_analyze_scale_factor = 0.02
autovacuum_vacuum_cost_limit = 2000

# --- Perffarm Telemetry & Observability ---
track_activities = on
track_counts = on
track_io_timing = on
@TRACK_WAL_IO_TIMING_LINE@
track_functions = all
@SHARED_PRELOAD_LIBRARIES_LINE@
@PG_STAT_STATEMENTS_LINES@

# --- Logging & Diagnostics ---
logging_collector = off
log_destination = 'stderr'
log_min_messages = warning
log_min_error_statement = error
log_min_duration_statement = 5000
log_checkpoints = on
log_autovacuum_min_duration = 1000
log_lock_waits = on
log_temp_files = 0
log_line_prefix = '%m [%p] %q%u@%d '
lc_messages = 'C'
timezone = 'UTC'
datestyle = 'iso, mdy'

# --- Optional Animal / Per-Test GUC Overrides ---
@EXTRA_GUC_LINES@
