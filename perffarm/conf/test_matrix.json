      "default_clients": 4,
      "default_threads": 2
    },
    "standard": {
      "description": "Standard continuous integration / per-commit Perffarm profile (60s per test)",
      "default_duration_sec": 60,
      "default_clients": 16,
      "default_threads": 4
    },
