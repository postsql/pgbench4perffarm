{
  "schema_version": "1.0",
  "description": "Declarative test matrix and sizing profiles (smoke, standard, nightly) for pgbench4perffarm.",
  "profiles": {
    "smoke": {
      "description": "Fast smoke & functional verification profile (5-10s per test, low scale factor)",
      "default_duration_sec": 5,
      "default_clients": 4,
      "default_threads": 2
    },
    "standard": {
      "description": "Standard continuous integration / per-commit Perffarm profile (60s per test)",
      "default_duration_sec": 60,
      "default_clients": 16,
      "default_threads": 4
    },
    "nightly": {
      "description": "Extended soak & high-scale nightly Perffarm profile (300s per test)",
      "default_duration_sec": 300,
      "default_clients": 32,
      "default_threads": 8
    }
